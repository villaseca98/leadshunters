    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🔥 <b>Nuevo lead · {{ $json.cliente }}</b>\n{{ $json.nombre }} · {{ $json.telefono }}\nDeuda: {{ $json.deuda ? $json.deuda.toLocaleString('es-ES') + ' €' : '¿?' }} · Acreedores: {{ $json.acreedores ?? '¿?' }} · {{ $json.cualificacion }}\nOrigen: {{ $json.origen }} {{ $json.campana || '' }}\n👉 Llama YA: {{ $env.APP_URL }}/cola",
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false
        }
      },
      "id": "51555525-55d2-4365-a4f8-02f2ea61fc87",
      "name": "🔥 Nuevo lead al equipo",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        940,
        160
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.EMAIL_FROM }}",
        "toEmail": "={{ $json.cliente_email }}",
        "subject": "=Nueva consulta: {{ $json.lead_nombre }} · {{ new Date($json.scheduled_at).toLocaleString('es-ES', { timeZone: 'Europe/Madrid', dateStyle: 'full', timeStyle: 'short' }) }}",
        "emailFormat": "html",
        "html": "=<div style=\"font-family:Arial,sans-serif;font-size:14px;color:#0f172a\">\n<h2 style=\"margin:0 0 12px\">Nueva consulta agendada</h2>\n<p><b>{{ $json.lead_nombre }}</b> · {{ $json.lead_telefono }}{{ $json.lead_email ? ' · ' + $json.lead_email : '' }}</p>\n<p><b>Cuándo:</b> {{ new Date($json.scheduled_at).toLocaleString('es-ES', { timeZone: 'Europe/Madrid', dateStyle: 'full', timeStyle: 'short' }) }} ({{ $json.mode }})</p>\n<table style=\"border-collapse:collapse;margin:12px 0\">\n<tr><td style=\"padding:4px 12px 4px 0;color:#64748b\">Deuda total</td><td>{{ $json.deuda ? $json.deuda.toLocaleString('es-ES') + ' €' : '—' }}</td></tr>\n<tr><td style=\"padding:4px 12px 4px 0;color:#64748b\">Acreedores</td><td>{{ $json.acreedores ?? '—' }}</td></tr>\n<tr><td style=\"padding:4px 12px 4px 0;color:#64748b\">Ingresos/mes</td><td>{{ $json.ingresos ? $json.ingresos.toLocaleString('es-ES') + ' €' : '—' }}</td></tr>\n<tr><td style=\"padding:4px 12px 4px 0;color:#64748b\">Situación laboral</td><td>{{ $json.situacion_laboral ?? '—' }}</td></tr>\n<tr><td style=\"padding:4px 12px 4px 0;color:#64748b\">Provincia</td><td>{{ $json.lead_provincia ?? '—' }}</td></tr>\n</table>\n<p><b>Resumen:</b> {{ ($json.resumen_cualificacion || []).join(' · ') }}</p>\n{{ $json.notas_llamada ? '<p><b>Notas de la llamada:</b> ' + $json.notas_llamada + '</p>' : '' }}\n<p style=\"margin-top:20px\">Después de la consulta, confirma si se realizó (solo se facturan las realizadas):<br>\n<a href=\"{{ $json.enlace_confirmar }}\" style=\"display:inline-block;margin-top:8px;padding:10px 16px;background:#4f46e5;color:#fff;border-radius:8px;text-decoration:none\">Confirmar asistencia</a></p>\n<p style=\"color:#94a3b8;font-size:12px\">Leads Hunters · datos tratados con el consentimiento del interesado para que su despacho estudie su caso.</p></div>",
        "options": {
          "appendAttribution": false
        }
      },
