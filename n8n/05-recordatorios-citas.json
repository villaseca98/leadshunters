{
  "name": "05 · Recordatorios de consultas",
  "nodes": [
    {
      "parameters": {
        "content": "## 05 · Recordatorios de consultas\nCada 30 min: recordatorio al lead de las consultas de las próximas 24 h (email; SMS con Twilio si lo activas). Menos ausencias = más consultas facturables.\n\nLa confirmación diaria de asistencia al despacho está en el flujo 05b.",
        "width": 540,
        "height": 200,
        "color": 4
      },
      "id": "aa2d60a4-6d98-4f2a-ab70-82191df0b032",
      "name": "Nota 700a",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        160,
        -60
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "dc8fd6f6-bc36-4cb6-aa34-7c46b7dc9983",
      "name": "Cada 30 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        260
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.LH_API_URL }}/api/v1/consultations/reminders",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $('Config').first().json.LH_API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "hours",
              "value": "24"
            }
          ]
        }
      },
      "id": "d7bf8473-5c2e-4b90-b40b-c5ec60b87592",
      "name": "Consultas en las próximas 24 h",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.first().json.consultations.map(c => ({ json: c }));"
      },
      "id": "079ad33d-786d-488d-97fb-ea615b68e6a2",
      "name": "Separar consultas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        260
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a3e934ac-45c5-416b-b847-511f84b42e7d",
              "leftValue": "={{ !!$json.lead_email }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "54778772-e811-4b23-97fa-217750bfd67e",
      "name": "¿Tiene email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        260
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $('Config').first().json.EMAIL_FROM }}",
        "toEmail": "={{ $json.lead_email }}",
        "subject": "=Recordatorio: tu consulta con {{ $json.cliente }}",
        "emailFormat": "html",
        "html": "=<div style=\"font-family:Arial,sans-serif;font-size:14px\">\n<p>Hola {{ $json.lead_nombre.split(' ')[0] }},</p>\n<p>Te recordamos tu consulta sobre la Ley de Segunda Oportunidad con <b>{{ $json.cliente }}</b>:\n<b>{{ new Date($json.scheduled_at).toLocaleString('es-ES', { timeZone: 'Europe/Madrid', dateStyle: 'full', timeStyle: 'short' }) }}</b> ({{ $json.mode }}).</p>\n<p>Si no puedes asistir, responde a este email y la cambiamos.</p></div>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "108cd6bb-6165-4c38-86c5-936afb8a9aa1",
      "name": "Recordatorio por email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1320,
        160
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "from": "={{ $('Config').first().json.TWILIO_FROM }}",
        "to": "={{ $('Separar consultas').item.json.lead_telefono }}",
        "message": "=Recordatorio: consulta con {{ $('Separar consultas').item.json.cliente }} el {{ new Date($('Separar consultas').item.json.scheduled_at).toLocaleString('es-ES', { timeZone: 'Europe/Madrid', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' }) }}.",
        "options": {}
      },
      "id": "64722e41-0939-4928-b92c-f1f95ac605b9",
      "name": "Recordatorio por SMS (opcional)",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        1320,
        360
      ],
      "disabled": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.LH_API_URL }}/api/v1/consultations/{{ $('Separar consultas').item.json.id }}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $('Config').first().json.LH_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"reminder_sent\": true}"
      },
      "id": "d30bb76b-8c3b-4880-bb3f-37f5869258d1",
      "name": "Marcar recordatorio enviado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        260
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "5f8280c2-72a5-443e-883a-7b790452a251",
              "name": "EMAIL_FROM",
              "value": "Leads Hunters <hola@tudominio.com>",
              "type": "string"
            },
            {
              "id": "868f6131-dcba-429b-839a-b5d76090cba4",
              "name": "LH_API_KEY",
              "value": "PEGA_AQUI_LA_N8N_API_KEY_DE_LA_APP",
              "type": "string"
            },
            {
              "id": "a12e9ccd-0209-470b-bd85-c52f0fd404d6",
              "name": "LH_API_URL",
              "value": "https://app.tudominio.com",
              "type": "string"
            },
            {
              "id": "7067072e-db8d-46dc-8935-c461afe2fc76",
              "name": "TWILIO_FROM",
              "value": "+34000000000",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "4fe78fdd-cfb9-4860-90c0-fcbf10ef2f2e",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
