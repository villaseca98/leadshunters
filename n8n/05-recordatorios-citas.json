              "type": "string"
            },
            {
              "id": "9c8be049-f33f-4916-8abe-e69e24716612",
              "name": "TWILIO_FROM",
              "value": "+34000000000",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "2d60a960-0dad-4821-9646-3c1fa86c942f",
      "name": "Config",
