      "typeVersion": 2,
      "position": [
        220,
        200
      ],
      "webhookId": "d548a621-787d-4a02-8611-6e35b161eb6f"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.mode'] === 'subscribe' ? $json.query['hub.challenge'] : 'no' }}",
        "options": {}
      },
      "id": "397aa035-3592-4319-a6ee-1d0f482ca33b",
      "name": "Responder a Meta",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Solo mensajes de texto o botones que escribe la persona (no estados de entrega)\nconst numeros = JSON.parse($('Config').first().json.WA_NUMEROS || '{}');\nconst out = [];\nfor (const entry of $input.first().json.body?.entry ?? []) for (const ch of entry.changes ?? []) {\n  const v = ch.value ?? {};\n  for (const m of v.messages ?? []) {\n    const text = m.text?.body ?? m.button?.text ?? m.interactive?.button_reply?.title ?? m.interactive?.list_reply?.title ?? '';\n    out.push({ json: { phone: m.from, text, phone_number_id: v.metadata?.phone_number_id, client_code: numeros[v.metadata?.phone_number_id] ?? null } });\n  }\n}\nreturn out;"
      },
      "id": "44ef9350-8836-42d3-8744-d0e1d1aea15e",
      "name": "Leer mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        460
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.LH_API_URL }}/api/v1/whatsapp",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $('Config').first().json.LH_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ phone: $json.phone, text: $json.text, client_code: $json.client_code }) }}"
      },
      "id": "9532334e-f376-4d38-9bae-345104ca026c",
      "name": "Asistente (app)",
