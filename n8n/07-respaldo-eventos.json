              "value": "100"
            }
          ]
        }
      },
      "id": "eb1d3434-1b12-4794-9f7e-cfc44b93ed50",
      "name": "Eventos pendientes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Solo reenviamos eventos con más de 2 minutos (los recientes los está entregando la app)\nconst limite = Date.now() - 2 * 60 * 1000;\nreturn $input.first().json.events.filter(e => Date.parse(e.created_at) < limite).map(e => ({ json: e }));"
      },
      "id": "0fef7158-8e3d-4a3b-bdb1-863bd50a8614",
      "name": "Separar eventos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.N8N_EVENTS_WEBHOOK_URL || 'http://localhost:5678/webhook/leads-hunters-eventos' }}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $('Config').first().json.LH_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $json.id, kind: $json.kind, payload: $json.payload, sent_at: new Date().toISOString() }) }}"
      },
      "id": "c3de01ce-4087-42a1-a837-8ee0f6cc4fa9",
      "name": "Reenviar al flujo 04",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const ids = $('Separar eventos').all().map(i => i.json.id);\nreturn ids.length ? [{ json: { ids } }] : [];"
      },
      "id": "f7dd812d-bc48-4e35-b0c6-1593f2a3796c",
