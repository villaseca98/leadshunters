      },
      "id": "1247fe70-b6a6-4527-9fef-b5edf1185632",
      "name": "Eventos pendientes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Solo reenviamos eventos con más de 2 minutos (los recientes los está entregando la app)\nconst limite = Date.now() - 2 * 60 * 1000;\nreturn $input.first().json.events.filter(e => Date.parse(e.created_at) < limite).map(e => ({ json: e }));"
      },
      "id": "eb00267a-bf3e-46f0-89ec-fe59f02676c7",
      "name": "Separar eventos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_EVENTS_WEBHOOK_URL || 'http://localhost:5678/webhook/leads-hunters-eventos' }}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.LH_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $json.id, kind: $json.kind, payload: $json.payload, sent_at: new Date().toISOString() }) }}"
      },
      "id": "519f136c-2385-4bc4-afda-462a143687f0",
      "name": "Reenviar al flujo 04",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const ids = $('Separar eventos').all().map(i => i.json.id);\nreturn ids.length ? [{ json: { ids } }] : [];"
      },
      "id": "851ec508-b567-4730-8528-33ff0257fb8a",
