      "id": "63853251-f626-46dd-8ca5-85fffd7c26f5",
      "name": "Apify · Perfiles de Instagram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3520,
        200
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const porUsuario = $('Usuarios de Instagram').first().json.porUsuario;\nconst hoy = Date.now();\nreturn $input.all()\n  .map(i => i.json)\n  .filter(p => p && p.username && porUsuario[p.username.toLowerCase()])\n  .map(p => {\n    const ultima = (p.latestPosts || []).map(x => x.timestamp).filter(Boolean).sort().at(-1);\n    return { json: {\n      id: porUsuario[p.username.toLowerCase()],\n      instagram: 'https://www.instagram.com/' + p.username,\n      instagram_followers: p.followersCount ?? null,\n      instagram_days_since_post: ultima ? Math.round((hoy - Date.parse(ultima)) / 864e5) : null,\n    } };\n  });"
      },
      "id": "e262e8aa-54a2-4ac6-a3f3-742d39a0697d",
