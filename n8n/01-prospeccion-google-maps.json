      "id": "a6c2bb6e-6041-44b7-9470-352d9949a3e7",
      "name": "Enviar análisis a la app",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2860,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Junta los usuarios de Instagram (de Google Maps o detectados en la web) en una sola llamada a Apify\nif (!$('Configuración').first().json.analizarInstagram) return [{ json: { usuarios: [], porUsuario: {} } }];\nconst usuarioDe = (url) => {\n  const m = (url || '').match(/instagram\\.com\\/([A-Za-z0-9_.]+)/i);\n  if (!m) return null;\n  const u = m[1].toLowerCase().replace(/\\.$/, '');\n  return ['p', 'reel', 'reels', 'explore', 'stories', 'accounts'].includes(u) ? null : u;\n};\nconst porUsuario = {};\n$('Separar despachos').all().forEach((it, i) => {\n  const detectado = $('Enviar análisis a la app').all()[i]?.json?.detected?.instagram;\n  const u = usuarioDe(it.json.instagram) || usuarioDe(detectado);\n  if (u) porUsuario[u] = it.json.id;\n});\nreturn [{ json: { usuarios: Object.keys(porUsuario), porUsuario } }];"
      },
      "id": "d1f5dce8-e66f-4ed3-abd5-bbae96a218cb",
      "name": "Usuarios de Instagram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3080,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "dc0e7fec-f866-4a04-b97d-efe9d7471e82",
              "leftValue": "={{ $json.usuarios.length > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "7c29ac8d-aa30-4079-a21e-1d0a264bad9e",
      "name": "¿Hay Instagram?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        3300,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.apify.com/v2/acts/apify~instagram-profile-scraper/run-sync-get-dataset-items?token={{ $('Config').first().json.APIFY_TOKEN }}&timeout=600",
        "options": {
