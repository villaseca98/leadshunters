      "id": "ccb66ff5-f839-4be7-bc50-debeee66f3c2",
      "name": "Configuración",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Combina cada búsqueda con cada ciudad: \"abogados segunda oportunidad Valencia\"\nconst c = $input.first().json;\nconst busquedas = [];\nfor (const ciudad of c.ciudades) for (const b of c.busquedas) busquedas.push(`${b} ${ciudad}`);\nreturn [{ json: {\n  searchStringsArray: busquedas,\n  maxCrawledPlacesPerSearch: c.maxPorBusqueda,\n  language: \"es\",\n  countryCode: \"es\",\n  skipClosedPlaces: true,\n  scrapeContacts: true,\n  scrapePlaceDetailPage: false,\n} }];"
      },
      "id": "2e6a42d7-0557-421a-ba8a-3eaae56c6e4c",
      "name": "Preparar búsquedas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.apify.com/v2/acts/compass~crawler-google-places/run-sync-get-dataset-items?token={{ $('Config').first().json.APIFY_TOKEN }}&timeout=900",
        "options": {
          "timeout": 900000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "id": "ba538854-24e2-4356-8315-58e020139304",
      "name": "Apify · Google Maps",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Manda todos los despachos a la app en una sola llamada (la app limpia, deduplica y puntúa)\nconst items = $input.all().map(i => i.json).filter(x => x && (x.title || x.name));\nreturn [{ json: { items, search_term: $('Configuración').first().json.busquedas.join(' | ') } }];"
      },
      "id": "d8188333-5f4b-4707-ba77-1a2be795a118",
      "name": "Agrupar resultados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ]
    },
