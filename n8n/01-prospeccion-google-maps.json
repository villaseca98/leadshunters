      "id": "5257714a-0390-4ebb-9b0b-6522aefc43eb",
      "name": "Meta · Biblioteca de anuncios",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2420,
        300
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
