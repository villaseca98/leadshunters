{
  "name": "05b · Confirmación de asistencia por el despacho",
  "nodes": [
    {
      "parameters": {
        "content": "## 05b · Confirmación de asistencia\nCada día a las 20:00 manda a cada despacho un email con las consultas ya pasadas que siguen sin confirmar (sin confirmar no se facturan).",
        "width": 540,
        "height": 140,
        "color": 4
      },
      "id": "424ffcf1-386e-448e-8452-e27825e78c1d",
      "name": "Nota b567",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        160,
        440
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 20
            }
          ]
        }
      },
      "id": "897b0c5b-5afe-48ed-b8ed-a59f6853a53e",
      "name": "Cada día 20:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        620
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.LH_API_URL }}/api/v1/consultations/unconfirmed",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $('Config').first().json.LH_API_KEY }}"
            }
          ]
        }
      },
      "id": "84d6fcb9-6a09-4d64-80e1-10f025e33a2e",
      "name": "Consultas pasadas sin confirmar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        620
      ]
    },
    {
      "parameters": {
        "jsCode": "// Un email por despacho con todas sus consultas pendientes de confirmar\nconst porCliente = {};\nfor (const c of $input.first().json.consultations) {\n  if (!c.cliente_email) continue;\n  (porCliente[c.client_id] ??= { cliente: c.cliente, email: c.cliente_email, consultas: [] }).consultas.push(c);\n}\nreturn Object.values(porCliente).map(x => ({ json: {\n  ...x,\n  filas: x.consultas.map(c => '<li>' + c.lead_nombre + ' · ' + new Date(c.scheduled_at).toLocaleString('es-ES', { timeZone: 'Europe/Madrid', dateStyle: 'medium', timeStyle: 'short' }) + ' · <a href=\"' + c.enlace_confirmar + '\">confirmar</a></li>').join(''),\n} }));"
      },
      "id": "65d40e43-59a2-4f47-96d8-bc2c1598766c",
      "name": "Agrupar por despacho",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        620
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $('Config').first().json.EMAIL_FROM }}",
        "toEmail": "={{ $json.email }}",
        "subject": "=¿Se realizaron estas consultas? ({{ $json.consultas.length }})",
        "emailFormat": "html",
        "html": "=<div style=\"font-family:Arial,sans-serif;font-size:14px\"><p>Hola,</p>\n<p>Estas consultas ya han pasado y aún no sabemos si se realizaron. Un clic en cada una nos basta:</p>\n<ul>{{ $json.filas }}</ul><p>¡Gracias!</p></div>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "022f4c0c-8266-41c7-920f-5900d0bc2214",
      "name": "Pedir confirmación al despacho",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1100,
        620
      ],
      "onError": "continueRegularOutput"
    },
